# 本地 IDEA 环境变量示例，不是服务器部署 .env。
# 复制为 .env.dev 后填写；该文件已被 Git 忽略。
# Spring Boot 不会自动读取此文件；在 IDEA 运行配置的环境变量中导入/填写。
SPRING_PROFILES_ACTIVE=dev

# 必填：沿用当前开发数据库对应的原加密密钥，不能随意生成或换成服务器密钥。
CALLNEXUS_DATA_ENCRYPT_KEY=填写本地原有的数据加密密钥

# 以下可选。不填写时沿用 application-dev.yml 的现有开发配置。
# CNX_JDBC_URL=jdbc:mysql://127.0.0.1:3306/call_nexus?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
# MYSQL_USER=填写开发数据库账号
# MYSQL_PASSWORD=填写开发数据库密码
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_PASSWORD=填写开发Redis密码
# CNX_SNAIL_TOKEN=填写开发调度组对应的令牌
# CNX_LOCAL_IP=127.0.0.1
# CALLNEXUS_AI_QDRANT_URL=http://127.0.0.1:6333
# QDRANT_API_KEY=填写开发向量库密钥

# 可选：不填写时保持原开发前后端密钥。修改时必须同步对应的前端密钥。
# CNX_API_REQUEST_PRIVATE_KEY=后端请求解密私钥
# CNX_API_RESPONSE_PUBLIC_KEY=后端响应加密公钥
# CNX_JWT_SECRET=开发登录签名密钥
# CNX_REALTIME_TOKEN_SECRET=开发实时语音令牌签名密钥
# CALLNEXUS_FREESWITCH_DIRECTORY_SECRET=开发FreeSWITCH动态目录共享密钥
